003100B3   // add  x1, x2, x3   : put x2 + x3 into x1
00028213   // addi x4, x5, 0   : put x5 + 0 into x4 (copies x5 into x4)
0003A303   // lw   x6, 0(x7)   : load the word at address x7 + 0 into x6
0084A023   // sw   x8, 0(x9)   : store x8 into the word at address x9 + 0
00000073   // ecall           : tell the testbench "program is done, stop"